# DEMO needs no API key. Copy this file to .env to enable REAL_AGENT.
LLM_PROVIDER=demo
# openai: Responses API; compatible: Chat Completions; deepseek: DeepSeek Chat Completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Set the model supported by your provider. Required in REAL_AGENT.
LLM_MODEL=
# DeepSeek configuration (keep LLM_API_KEY local; never commit real credentials):
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
